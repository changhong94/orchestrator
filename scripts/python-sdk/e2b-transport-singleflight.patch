+# Envd connection pools remain thread-local. Only the default, verified trust
+# context is shared, lazily inside the first API/command request. An explicit trust
+# environment keeps HTTPX's original construction policy.
+_default_tls_lock = threading.Lock()
+_default_tls_contexts = {}
+
+def _get_default_ssl_context(http2):
+    import os
+    import certifi
+    from httpx._config import create_ssl_context
+    if os.environ.get("SSL_CERT_FILE") or os.environ.get("SSL_CERT_DIR"):
+        return create_ssl_context()
+    ca = os.path.realpath(certifi.where())
+    st = os.stat(ca)
+    key = (http2, ca, st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
+    with _default_tls_lock:
+        cached = _default_tls_contexts.get(key)
+        if cached is not None:
+            return cached
+        context = create_ssl_context(trust_env=False)
+        # Never cache a failed construction. Bound cache retention when the
+        # CA bundle is replaced; existing transports keep their own references.
+        if len(_default_tls_contexts) >= 4:
+            _default_tls_contexts.clear()
+        _default_tls_contexts[key] = context
+        return context
