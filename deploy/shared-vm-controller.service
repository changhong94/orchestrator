# Optional runtime owner for prepared VM pools. See shared-vm-controller.txt.
[Unit]
Description=Kuasar shared prepared VM controller
After=store-ctl.service
[Service]
Type=notify
NotifyAccess=main
RuntimeDirectory=kuasar-shared-controller
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/node-vm-runner shared-runs /run/kuasar-shared-controller/runs.sock
TimeoutStopSec=60
Restart=on-failure
RestartSec=1
